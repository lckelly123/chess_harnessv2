# Copy to .env at the repository root. Do not commit real credentials.
# Docker Desktop -> LM Studio running on the host (not container localhost).
LMSTUDIO_BASE_URL=http://host.docker.internal:1234/v1
# Host-run LangGraph Studio uses this URL instead of the Docker URL above.
LMSTUDIO_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
# Optional: leave blank to select the only model currently loaded in LM Studio.
# When multiple models are loaded, set the exact identifier to remove ambiguity.
LMSTUDIO_MODEL=
# Placeholder works when LM Studio authentication is disabled.
LMSTUDIO_API_KEY=lm-studio
LMSTUDIO_REASONING_EFFORT=medium
LMSTUDIO_RETRY_REASONING_EFFORT=none

# Unsloth: the supplied local URL/token are defaults in backend/harness/model.py.
# These optional overrides support Docker or a different Unsloth installation.
UNSLOTH_BASE_URL=http://host.docker.internal:8888/v1
UNSLOTH_API_KEY=
# Blank discovers the only loaded checkpoint; the UI can select its exact id.
UNSLOTH_MODEL=
# Non-streaming reasoning passes can take several minutes on the local 14B model.
UNSLOTH_TIMEOUT_SECONDS=600

# GRPO data collection: start the Windows capture worker with
# .\scripts\start-grpo-capture.ps1 (uses the installed Unsloth Python environment).
# Docker reaches that host worker here; a native backend defaults to 127.0.0.1.
GRPO_CAPTURE_BASE_URL=http://host.docker.internal:8890
# The launcher creates .runtime/grpo-capture.token. Docker reads it through the
# existing read-only runtime mount; native backends discover that same file.
# Native backends can override its path with GRPO_CAPTURE_TOKEN_FILE.
# Docker writes through the project bind mount models/training_data/RL_testing.
# Native backends can optionally override that directory with GRPO_OUTPUT_ROOT.
# GRPO_OUTPUT_ROOT=C:\Repos\chess_harness_v2\chess_harnessv2\models\training_data\RL_testing

# Optional: required only when GPT Terra is selected in the web UI.
# Backend only. Never use a VITE_ variable for this key.
OPENAI_API_KEY=
# Total reasoning + visible output tokens per call; not a thinking-only cap.
# Normal calls use medium reasoning; forced-format retries use none.
OPENAI_MAX_OUTPUT_TOKENS=8000
OPENAI_RETRY_MAX_OUTPUT_TOKENS=2000

# Opt in: recorded prompts, model outputs and tool results leave your machine.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=chess-harness-v2-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Set if your API key needs an explicit workspace.
LANGSMITH_WORKSPACE_ID=

# Local match execution. Games continue until a rule-derived chess result or Stop.
MATCH_DATABASE_PATH=/app/data/chess-harness.sqlite3
MATCH_MAX_ACTIVE=1

# Local PostgreSQL position library; published on loopback only.
# The backend connects through the Docker network on port 5432.
POSITIONS_DB_NAME=chess_positions
POSITIONS_DB_USER=chess
POSITIONS_DB_PASSWORD=chess_local
POSITIONS_DB_PORT=5433

# Automatic grading of new positional runs. Total nodes = budget × legal moves.
POSITION_EVAL_NODES_PER_MOVE=500000
POSITION_EVAL_HASH_MB=128
POSITION_EVAL_TIMEOUT_SECONDS=180
# Each queue position has 5,000 seconds (83 minutes 20 seconds) for the model turn and grading.
# Apply changes by recreating the backend; doing so interrupts its active position.
POSITION_QUEUE_ITEM_TIMEOUT_SECONDS=5000
# Host-run backend only: point STOCKFISH_PATH to a Stockfish executable.
# Docker bundles a checksum-pinned Stockfish 18 executable.
